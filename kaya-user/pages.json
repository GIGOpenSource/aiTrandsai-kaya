	"preloadRule": {
		"pages/home/index": {
			"network": "all",
			"packages": [
				"pages-sub"
			]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "white",
		"navigationBarBackgroundColor": "#0c0813",
		"backgroundColor": "#0c0813",
		"backgroundColorTop": "#0c0813",
		"backgroundColorBottom": "#0c0813",
		"app-plus": {
			"bounce": "none"
		}
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^App(.*)": "@/components/App$1.vue",
			"^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue"
		}
	}
