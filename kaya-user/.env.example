# Copy to .env / .env.local. Do not commit real secrets.

# 应用环境：prod | test
# - test：Firebase 事件名自动加 test_ 前缀；请配合测试 API
# - prod：正式环境（默认）
VITE_APP_ENV=test

# API origin for App / production H5.
# H5 本地开发（含局域网 IP）请留空，走下方 Vite 代理，避免 CORS。
VITE_API_BASE_URL=

# Optional explicit WS origin. H5 dev should leave empty (uses page host + Vite /ws proxy).
VITE_WS_URL=

# Vite proxy target when VITE_API_BASE_URL is empty (H5 only)
VITE_PROXY_TARGET=https://www.test-trandsai.site
