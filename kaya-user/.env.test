# 测试环境配置模板（占位地址，正式测试域名出来后替换）
# 用法：复制为 `.env` 或 `.env.local` 后再编译/运行测试包
#   cp .env.test .env.local
#
# HBuilderX：把本文件内容贴进项目根目录 `.env`，再重新运行到手机/云打包。
# CLI：uni build --mode test 时会自动读 `.env.test`（若工具链支持 mode）。

VITE_APP_ENV=test

# TODO: 替换为真实测试服 API（当前为占位，请求会失败属正常）
VITE_API_BASE_URL=https://test.trandsai.com
VITE_WS_URL=wss://test.trandsai.com
VITE_PROXY_TARGET=https://test.trandsai.com
