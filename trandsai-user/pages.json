		"backgroundColorBottom": "#0f0f12",
		"app-plus": {
			"bounce": "none"
		}
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^App(.*)": "@/components/App$1.vue",
			"^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue"
		}
