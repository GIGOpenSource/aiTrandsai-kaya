# 应用环境：prod=正式 | test=测试（Firebase 事件名会加 test_ 前缀）
# 改完后必须重新编译/运行，热更新不会生效
VITE_APP_ENV=test
VITE_USE_TRANDS_IAP=1

# API 根地址
# - H5 开发：可留空，走 vite proxy
# - App：必须写完整域名
# VITE_API_BASE_URL=https://www.trandsai.com

# WebSocket（一般跟 API 同域；不写则按 API 自动推导）
# VITE_WS_URL=wss://www.trandsai.com

# ---------- 切到测试环境时改成下面这样 ----------
# VITE_APP_ENV=test
VITE_API_BASE_URL=https://www.test-trandsai.site
# VITE_WS_URL=wss://这里换成你的测试WS地址
